<?xml version="1.0" encoding="utf-8"?>
<!--
  The update feed the app polls (SUFeedURL in the bundle's Info.plist).

  It is empty on purpose until the Developer ID certificate exists: an entry
  here is an offer to replace the app on someone's machine, and until releases
  are signed, notarised and EdDSA-signed there is nothing safe to offer. An
  empty channel is a valid feed — the app says "you're up to date" and stops,
  which is the truth.

  The release job fills this in once signing is set up; see docs/UPDATES.md.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>WhatsMyUsage</title>
    <link>https://whatsmyusage.com/appcast.xml</link>
    <description>Updates for WhatsMyUsage</description>
    <language>en</language>
  </channel>
</rss>
